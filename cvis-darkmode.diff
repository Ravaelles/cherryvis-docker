diff --git a/replays/static/replays/darkmode.css b/replays/static/replays/darkmode.css
new file mode 100644
index 0000000..f98dca4
--- /dev/null
+++ b/replays/static/replays/darkmode.css
@@ -0,0 +1,132 @@
+/*
+ * CherryVis dark mode extension.
+ *
+ * Extends upstream styles without modifying upstream stylesheets
+ * (Open/Closed Principle). All dark theme rules are scoped under
+ * body.cvis-dark, so the default light theme keeps working untouched.
+ * Theme behavior lives in darkmode.js (Single Responsibility).
+ */
+
+/* Requested base control tone. Applies in both themes. */
+input[type="text"],
+select,
+#game-slider {
+  background-color: #b1b1b1;
+}
+
+input[type="text"] {
+  color: #181b22;
+  border-color: #6c757d;
+}
+
+input[type="text"]::placeholder {
+  color: #3a3f44;
+  opacity: 1;
+}
+
+select {
+  color: #181b22;
+  border-color: #6c757d;
+}
+
+#game-slider {
+  border: 1px solid #6c757d;
+}
+
+/* Dark theme root. */
+body.cvis-dark {
+  background-color: #121212;
+  color: #e0e0e0;
+  color-scheme: dark;
+}
+
+/* Main layout surfaces. */
+body.cvis-dark .content,
+body.cvis-dark .wrapper,
+body.cvis-dark .content-padding,
+body.cvis-dark .container {
+  background-color: #121212;
+  color: #e0e0e0;
+}
+
+body.cvis-dark p {
+  color: #b0b0b0;
+}
+
+body.cvis-dark h2,
+body.cvis-dark h4 {
+  color: #e0e0e0;
+}
+
+/* Replay list. */
+body.cvis-dark .list-group-item {
+  background-color: #1e1e1e;
+  border-color: #333333;
+  color: #e0e0e0;
+}
+
+body.cvis-dark .list-group-item-light {
+  background-color: #1e1e1e;
+  color: #b0b0b0;
+}
+
+body.cvis-dark .list-group-item-primary {
+  background-color: #23425f;
+  border-color: #2f5375;
+  color: #e0e0e0;
+}
+
+body.cvis-dark a .list-group-item-primary:hover,
+body.cvis-dark button.list-group-item-primary:hover {
+  background-color: #2e5579;
+  color: #ffffff;
+}
+
+body.cvis-dark .badge-light {
+  background-color: #3a3f44;
+  color: #e0e0e0;
+}
+
+/* Pattern input keeps the requested gray fill in dark mode as well. */
+body.cvis-dark input[type="text"].form-control,
+body.cvis-dark select.form-control {
+  background-color: #b1b1b1;
+  color: #181b22;
+  border-color: #6c757d;
+}
+
+body.cvis-dark input[type="text"].form-control:focus,
+body.cvis-dark select.form-control:focus {
+  background-color: #b1b1b1;
+  color: #181b22;
+  border-color: #9a9a9a;
+  box-shadow: 0 0 0 0.2rem rgba(177, 177, 177, 0.25);
+}
+
+/* Game view surfaces keep their dark infobar look. */
+body.cvis-dark .infobar-container,
+body.cvis-dark .controls-container {
+  background-color: #121212;
+}
+
+body.cvis-dark #canvas {
+  border-color: #6c757d;
+}
+
+/* Setup alerts readable on dark background. */
+body.cvis-dark .alert-info {
+  background-color: #1c3a4a;
+  border-color: #2f5375;
+  color: #cfe8f5;
+}
+
+body.cvis-dark .alert-danger {
+  background-color: #4a2323;
+  border-color: #6b3232;
+  color: #f5d6d6;
+}
+
+/* Theme toggle placement. */
+#cvis-theme-toggle {
+  white-space: nowrap;
+}
diff --git a/replays/static/replays/darkmode.js b/replays/static/replays/darkmode.js
new file mode 100644
index 0000000..105ae69
--- /dev/null
+++ b/replays/static/replays/darkmode.js
@@ -0,0 +1,161 @@
+/*
+ * CherryVis dark mode controller.
+ *
+ * Single Responsibility: this module only manages the visual theme.
+ * It does not handle replays, game state, or debug panels.
+ *
+ * SOLID notes:
+ * - Single Responsibility: storage, DOM application, and orchestration
+ *   are split into CvisThemeStorage, CvisThemeApplicator, CvisThemeManager.
+ * - Open/Closed: new theme names can be introduced through THEMES without
+ *   changing the manager logic.
+ * - Liskov Substitution / Interface Segregation: small constructor
+ *   functions with narrow methods; the manager depends on these small
+ *   abstractions, injected via constructor.
+ * - Dependency Inversion: the manager depends on storage and applicator
+ *   abstractions, not on window.localStorage or document directly.
+ */
+(function () {
+  'use strict';
+
+  var THEME_KEY = 'cvis-theme';
+  var DARK_CLASS = 'cvis-dark';
+  var DARK_VALUE = 'dark';
+  var LIGHT_VALUE = 'light';
+  var TOGGLE_ID = 'cvis-theme-toggle';
+  var DARK_LABEL = 'Light mode';
+  var LIGHT_LABEL = 'Dark mode';
+
+  var THEMES = {};
+  THEMES[DARK_VALUE] = DARK_CLASS;
+  THEMES[LIGHT_VALUE] = '';
+
+  function CvisThemeStorage(key, backend) {
+    this.key = key;
+    this.backend = backend;
+  }
+
+  CvisThemeStorage.prototype.load = function () {
+    try {
+      return this.backend.getItem(this.key);
+    } catch (error) {
+      return null;
+    }
+  };
+
+  CvisThemeStorage.prototype.save = function (value) {
+    try {
+      this.backend.setItem(this.key, value);
+    } catch (error) {
+      /* Storage unavailable (private mode). Theme still applies. */
+    }
+  };
+
+  function CvisThemeApplicator(documentRef) {
+    this.documentRef = documentRef;
+  }
+
+  CvisThemeApplicator.prototype.current = function () {
+    if (this.documentRef.body.classList.contains(DARK_CLASS)) {
+      return DARK_VALUE;
+    }
+    return LIGHT_VALUE;
+  };
+
+  CvisThemeApplicator.prototype.apply = function (theme) {
+    var isDark = theme === DARK_VALUE;
+    if (isDark) {
+      this.documentRef.body.classList.add(DARK_CLASS);
+    } else {
+      this.documentRef.body.classList.remove(DARK_CLASS);
+    }
+    try {
+      this.documentRef.documentElement.style.colorScheme = isDark ? DARK_VALUE : LIGHT_VALUE;
+      this.documentRef.documentElement.setAttribute('data-cvis-theme', theme);
+    } catch (error) {
+      /* Non-critical styling hint. */
+    }
+    this.updateToggle(isDark);
+  };
+
+  CvisThemeApplicator.prototype.updateToggle = function (isDark) {
+    var button = this.documentRef.getElementById(TOGGLE_ID);
+    if (!button) {
+      return;
+    }
+    button.textContent = isDark ? DARK_LABEL : LIGHT_LABEL;
+    button.setAttribute('aria-pressed', isDark ? 'true' : 'false');
+  };
+
+  function CvisThemeManager(storage, applicator, systemPrefersDark) {
+    this.storage = storage;
+    this.applicator = applicator;
+    this.systemPrefersDark = systemPrefersDark;
+  }
+
+  CvisThemeManager.prototype.resolveInitial = function () {
+    var stored = this.storage.load();
+    if (stored === DARK_VALUE || stored === LIGHT_VALUE) {
+      return stored;
+    }
+    return this.systemPrefersDark ? DARK_VALUE : LIGHT_VALUE;
+  };
+
+  CvisThemeManager.prototype.init = function () {
+    var initial = this.resolveInitial();
+    this.applicator.apply(initial);
+    this.bindToggle();
+  };
+
+  CvisThemeManager.prototype.bindToggle = function () {
+    var doc = this.applicator.documentRef;
+    var button = doc.getElementById(TOGGLE_ID);
+    if (!button) {
+      return;
+    }
+    var self = this;
+    button.addEventListener('click', function () {
+      self.toggle();
+    });
+  };
+
+  CvisThemeManager.prototype.toggle = function () {
+    var next = this.applicator.current() === DARK_VALUE ? LIGHT_VALUE : DARK_VALUE;
+    this.applicator.apply(next);
+    this.storage.save(next);
+  };
+
+  function detectSystemPreference(windowRef) {
+    try {
+      if (windowRef.matchMedia) {
+        return windowRef.matchMedia('(prefers-color-scheme: dark)').matches;
+      }
+    } catch (error) {
+      /* Ignore and fall back to light theme. */
+    }
+    return false;
+  }
+
+  function boot() {
+    var backend;
+    try {
+      backend = window.localStorage;
+    } catch (error) {
+      backend = {
+        getItem: function () { return null; },
+        setItem: function () {}
+      };
+    }
+    var storage = new CvisThemeStorage(THEME_KEY, backend);
+    var applicator = new CvisThemeApplicator(document);
+    var manager = new CvisThemeManager(storage, applicator, detectSystemPreference(window));
+    manager.init();
+    window.cvisThemeManager = manager;
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', boot);
+  } else {
+    boot();
+  }
+})();
