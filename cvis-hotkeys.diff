+// StarCraft runs at ~23.81 fps (1000/42ms per frame); same constant as in
+// bmnielsen/dgant openbw-replay-viewer v1.4 (info-bar.js: const fps = 1000/42).
+var CVIS_FPS = (1000 / 42);
+
+function jump_seconds(seconds) {
+  if (typeof main_has_been_called !== 'undefined' && !main_has_been_called) return;
+  if (typeof _replay_get_value !== 'function' || typeof _replay_set_value !== 'function') return;
+  var frame = Math.max(0, _replay_get_value(2) + Math.round(CVIS_FPS * seconds));
+  _replay_set_value(3, frame);
+}
