diff --git a/replays/static/replays/cdb/cvis_dbg_lib.js b/replays/static/replays/cdb/cvis_dbg_lib.js
index cc7eca5..d0cef45 100644
--- a/replays/static/replays/cdb/cvis_dbg_lib.js
+++ b/replays/static/replays/cdb/cvis_dbg_lib.js
@@ -7,6 +7,26 @@
 
 "use strict";
 
+// Activate a newly tracked tab in #cherrypi-state-tabs-nav programmatically.
+// Uses Bootstrap's tab API so both the nav link (active) and the pane (active show)
+// are updated; falls back to a click when the plugin is unavailable.
+// Retries briefly because the nav item is built on the next CDB update,
+// which may be delayed while the replay is paused.
+function cvis_activate_tracked_tab(tabSelector, retriesLeft) {
+  if (retriesLeft === undefined) retriesLeft = 10;
+  var link = $('#cherrypi-state-tabs-nav a[href="' + tabSelector + '"]');
+  if (link && link.length) {
+    if (typeof link.tab === "function") link.tab('show');
+    else link.click();
+    return;
+  }
+  if (retriesLeft > 0) {
+    setTimeout(function() {
+      cvis_activate_tracked_tab(tabSelector, retriesLeft - 1);
+    }, 40);
+  }
+}
+
 const XYPixelsPerWalktile = 8;
 
 function cvis_dbg_lib_init(global_data, cvis_state) {
